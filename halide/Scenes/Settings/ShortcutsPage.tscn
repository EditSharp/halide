[gd_scene format=3]

[ext_resource type="Script" path="res://Scripts/UI/Settings/ShortcutsPage.cs" id="1_page"]
[ext_resource type="PackedScene" path="res://Scenes/Settings/ShortcutCategory.tscn" id="2_category"]
[ext_resource type="PackedScene" path="res://Scenes/Settings/ShortcutRow.tscn" id="3_row"]

[node name="ShortcutsPage" type="VBoxContainer" node_paths=PackedStringArray("resetAll", "list")]
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 12
script = ExtResource("1_page")
resetAll = NodePath("Header/ResetAll")
list = NodePath("Scroll/Margin/List")
categoryScene = ExtResource("2_category")
rowScene = ExtResource("3_row")

[node name="Header" type="HBoxContainer" parent="."]
layout_mode = 2
alignment = 2

[node name="ResetAll" type="Button" parent="Header"]
custom_minimum_size = Vector2(90, 27)
layout_mode = 2
tooltip_text = "Every shortcut back to its default keys"
theme_type_variation = &"InspectorButton"
text = "Reset All"

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Margin" type="MarginContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/margin_right = 12

[node name="List" type="VBoxContainer" parent="Scroll/Margin"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6
