Id = "home.sort.opened"

[sub_resource type="Resource" id="text_2"]
script = ExtResource("text")
Text = "Name"

[sub_resource type="Resource" id="button_2"]
script = ExtResource("button")
Text = SubResource("text_2")
Id = "home.sort.name"

[sub_resource type="Resource" id="text_3"]
script = ExtResource("text")
