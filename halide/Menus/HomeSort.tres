[sub_resource type="Resource" id="button_3"]
script = ExtResource("button")
Text = SubResource("text_3")
Id = "home.sort.created"

[sub_resource type="Resource" id="radio_4"]
script = ExtResource("radio")
Buttons = Array[ExtResource("button")]([SubResource("button_1"), SubResource("button_2"), SubResource("button_3")])
