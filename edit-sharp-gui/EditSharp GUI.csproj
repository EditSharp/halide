<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>EditSharpGUI</RootNamespace>
    <UserSecretsId>29b9d31f-ebf6-4493-9b3b-ea5f469a7e03</UserSecretsId>
    <!-- EditSharp from ../EditSharp or nuget.org; see Directory.Build.targets -->
    <UsesEditSharp>true</UsesEditSharp>
  </PropertyGroup>
  <ItemGroup>
    <Folder Include="Media\" />
    <Folder Include="Media\Example\" />
    <Folder Include="Media\Example\Video\" />
    <Folder Include="Scripts\Tests\" />
  </ItemGroup>
  <ItemGroup>
    <!-- SkiaSharp ships Windows and macOS natives itself; Linux needs this -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.152.1" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Media\Example\Video\video3.mp4">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>